# The image needs server.py + tools/ + requirements.txt, plus the rule
# corpus under resources/examples/ -- the coverage resource reads it at
# runtime, so excluding it shipped an image whose own resource answered
# "rule corpus directory not found". Everything else (Claude Code plugin
# surface + dev artefacts) stays out.
.git/
.github/
.claude-plugin/
skills/
prompts/
scripts/
tests/
*.md
.gitignore
.gitattributes
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
Dockerfile
.dockerignore
