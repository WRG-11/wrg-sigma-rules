# The image needs server.py + tools/ + requirements.txt, plus the rule
# corpus under resources/examples/ -- the coverage resource reads it at
# runtime, so excluding it shipped an image whose own resource answered
# "rule corpus directory not found". Everything else (Claude Code plugin
# surface + dev artefacts) stays out.
.git/
.github/
.claude-plugin/
# ...but let plugin.json ITSELF through: server.py reads the version from
# it and raises RuntimeError when it is missing. Directory out, one file in.
# Measured: without this line the image BUILDS but the server never starts
# -- FileNotFoundError: /app/.claude-plugin/plugin.json
!.claude-plugin/plugin.json
skills/
prompts/
scripts/
tests/
*.md
.gitignore
.gitattributes
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
Dockerfile
.dockerignore
